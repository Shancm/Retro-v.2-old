#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
CONFIG="/etc/retro/retro.conf"
[[ -r "$CONFIG" ]] && source "$CONFIG"
cmd="${1:-help}"
log(){ logger -t retro -- "$*"; printf '%s\n' "$*"; }
need_root(){ [[ $EUID -eq 0 ]] || { echo "This command requires root; use sudo." >&2; exit 1; }; }
case "$cmd" in
  help|-h|--help)
    cat <<'EOF'
Retro OS controller
  retro status              Show core service and memory status
  retro ghost status        Report Tor service state
  retro ghost on|off        Enable or disable the Tor daemon (not system-wide anonymity)
  retro doctor              Diagnose and safely repair selected service issues
  retro timewarp list       List Btrfs/Snapper snapshots
  retro timewarp create     Create a Snapper snapshot
  retro panic               Best-effort emergency response; NOT guaranteed RAM zeroization
  retro bujji               Launch the Bujji local assistant
EOF
    ;;
  status)
    printf 'OS: '; . /etc/os-release; printf '%s (%s)\n' "${PRETTY_NAME:-unknown}" "$(uname -m)"
    printf '\nMemory:\n'; free -h
    printf '\nZRAM:\n'; swapon --show
    printf '\nServices:\n'
    for s in earlyoom nftables usbguard tor; do
      printf '%-12s %s\n' "$s" "$(systemctl is-active "$s" 2>/dev/null || true)"
    done
    ;;
  ghost)
    action="${2:-status}"
    case "$action" in
      status) systemctl --no-pager --full status tor || true
              echo "Tor service status does not prove that application traffic uses Tor." ;;
      on) need_root; systemctl enable --now tor; log "Tor daemon enabled; configure applications/proxy explicitly." ;;
      off) need_root; systemctl disable --now tor; log "Tor daemon stopped." ;;
      *) echo "Usage: retro ghost status|on|off" >&2; exit 2 ;;
    esac
    ;;
  doctor)
    need_root
    failed=0
    for s in earlyoom nftables; do
      if ! systemctl is-active --quiet "$s"; then
        echo "Repair attempt: starting $s"
        systemctl enable --now "$s" || failed=1
      fi
    done
    if ! command -v btrfs >/dev/null; then echo "Missing btrfs-progs; install it before using snapshots."; failed=1; fi
    if ((failed)); then echo "Doctor found issues it could not repair automatically." >&2; exit 1; fi
    echo "Doctor completed."
    ;;
  timewarp)
    sub="${2:-list}"
    case "$sub" in
      list) command -v snapper >/dev/null || { echo "snapper not installed" >&2; exit 1; }; snapper -c root list ;;
      create) need_root; command -v snapper >/dev/null || exit 1
              snapper -c root create --description "Retro manual snapshot" --cleanup-algorithm number ;;
      *) echo "Usage: retro timewarp list|create" >&2; exit 2 ;;
    esac
    ;;
  panic)
    need_root
    echo "PANIC MODE: stopping networking and requesting kernel key erasure where supported."
    # Do not pretend userspace can reliably zero every RAM page. This is a best-effort response.
    systemctl stop NetworkManager.service networking.service 2>/dev/null || true
    if command -v keyctl >/dev/null; then keyctl clear @s 2>/dev/null || true; fi
    if command -v swapoff >/dev/null; then
      echo "Swap remains enabled to avoid destabilizing a memory-constrained system."
    fi
    log "Panic response invoked. RAM zeroization is not guaranteed; power-off is required for strongest practical volatile-memory clearing."
    ;;
  bujji)
    exec python3 /opt/retro-ai/bujji.py "${@:2}"
    ;;
  *)
    echo "Unknown command: $cmd" >&2; exit 2 ;;
esac
