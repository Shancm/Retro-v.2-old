#!/usr/bin/env bash
# =============================================================================
# Retro OS v2.0 - config.env
# Single source of truth for the host build (build.sh) and the in-chroot
# setup scripts (01..04, 98, 99). Must be SOURCED, never executed.
#
# Context handling:
#   RETRO_CONTEXT=host    -> set by build.sh (logs go to ${BUILD_ROOT}/logs)
#   RETRO_CONTEXT=chroot  -> default; scripts run as root INSIDE the chroot
#
# NOTE: the "already loaded" guard is intentionally a NON-exported shell
# variable. An exported guard leaks from build.sh into `chroot`, which makes
# the in-chroot `source config.env` return early and leaves retro_info() &
# friends undefined.
# =============================================================================

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "config.env must be sourced, not executed directly." >&2
    exit 1
fi

if [[ -n "${__RETRO_CONFIG_SOURCED:-}" ]]; then
    return 0
fi
__RETRO_CONFIG_SOURCED=1

set -Eeuo pipefail

: "${RETRO_CONTEXT:=chroot}"
export RETRO_CONTEXT

# -----------------------------------------------------------------------------
# Distro identity / branding
# -----------------------------------------------------------------------------
export RETRO_OS_NAME="Retro OS"
export RETRO_OS_CODENAME="retro-os"
export RETRO_OS_VERSION="2.0"
export RETRO_OS_EDITION="Tactical"
export RETRO_FOUNDER="Shan CM"
export RETRO_HOSTNAME="retro-os"

export RETRO_ACCENT_COLOR="#00FF9C"   # Neon Mint
export RETRO_CRIMSON_COLOR="#FF0055"  # Cyber Crimson
export RETRO_BG_COLOR="#0C0D12"       # Obsidian
export RETRO_FG_COLOR="#E0E0E0"
export RETRO_FONT_NAME="JetBrains Mono"   # Debian package: fonts-jetbrains-mono
export RETRO_UI_FONT="DejaVu Sans"
export RETRO_ICON_THEME="Papirus-Dark"
export RETRO_GTK_THEME="Arc-Dark"

# -----------------------------------------------------------------------------
# Debian base
# -----------------------------------------------------------------------------
export DEBIAN_SUITE="${DEBIAN_SUITE:-bookworm}"
export DEBIAN_MIRROR="${DEBIAN_MIRROR:-https://deb.debian.org/debian/}"
export DEBIAN_SECURITY_MIRROR="${DEBIAN_SECURITY_MIRROR:-https://security.debian.org/debian-security}"
export DEBIAN_COMPONENTS="main contrib non-free non-free-firmware"
export DEBIAN_ARCH="amd64"

# -----------------------------------------------------------------------------
# Build layout (host side)
# -----------------------------------------------------------------------------
_RETRO_CFG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export BUILD_ROOT="${BUILD_ROOT:-${_RETRO_CFG_DIR}/build}"
export CHROOT_DIR="${BUILD_ROOT}/chroot"
export IMAGE_DIR="${BUILD_ROOT}/image"
export ISO_DIR="${BUILD_ROOT}/iso"
export OUT_DIR="${BUILD_ROOT}/out"
export SCRIPTS_DIR="${_RETRO_CFG_DIR}/scripts"
export OVERLAY_DIR="${_RETRO_CFG_DIR}/overlay"
export STAGE_DIR_IN_CHROOT="/tmp/retro-build"

export ISO_LABEL="RETRO_OS_V2"
export ISO_FILENAME="retro-os-v${RETRO_OS_VERSION}-${DEBIAN_ARCH}.iso"
export SQUASHFS_ZSTD_LEVEL="${SQUASHFS_ZSTD_LEVEL:-19}"

# Kernel command-line fragments shared by ISOLINUX and GRUB menus.
# live-config reads live-config.username / hostname; keep them in sync with
# RETRO_USER so live-config never creates a second "user" account.
export RETRO_KARGS_COMMON="boot=live components username=retro live-config.username=retro hostname=${RETRO_HOSTNAME} live-config.hostname=${RETRO_HOSTNAME} nowatchdog"

# -----------------------------------------------------------------------------
# In-chroot paths (absolute, as seen from inside the chroot)
# -----------------------------------------------------------------------------
export RETRO_ROOT="/opt/retro-os"
export RETRO_BIN_DIR="/usr/local/bin"
export RETRO_SBIN_DIR="/usr/local/sbin"
export RETRO_HELPER_DIR="${RETRO_ROOT}/bin"
export RETRO_AI_DIR="/opt/retro-ai"
export RETRO_ETC_DIR="/etc/retro-os"
export RETRO_STATE_DIR="/var/lib/retro-os"
export RETRO_RUN_DIR="/run/retro-os"

if [[ "${RETRO_CONTEXT}" == "host" ]]; then
    export RETRO_LOG_DIR="${BUILD_ROOT}/logs"
    export RETRO_LOG_FILE="${RETRO_LOG_DIR}/build-$(date +%Y%m%d-%H%M%S).log"
else
    export RETRO_LOG_DIR="/var/log/retro-os"
    export RETRO_LOG_FILE="${RETRO_LOG_DIR}/retro-os.log"
fi

# -----------------------------------------------------------------------------
# Default user (live + first boot)
# -----------------------------------------------------------------------------
export RETRO_USER="retro"
export RETRO_USER_UID="1000"
export RETRO_USER_PASS="retro"
export RETRO_ROOT_PASS="retro"
export RETRO_USER_GROUPS="autologin,nopasswdlogin,sudo,audio,video,plugdev,netdev,wireshark"

# -----------------------------------------------------------------------------
# Locale / time
# -----------------------------------------------------------------------------
export RETRO_LOCALE="en_US.UTF-8"
export RETRO_TIMEZONE="UTC"
export RETRO_KEYMAP="us"

# -----------------------------------------------------------------------------
# Adaptive hardware profile (read at runtime from /etc/retro-os/retro.conf)
# -----------------------------------------------------------------------------
# A nominal "2 GB" PC reports roughly 1.7-2.0 GiB in MemTotal (BIOS/GPU
# reservations), so the boundary between tiers is expressed in MiB of
# *reported* RAM instead of a literal 2048.
export RETRO_LOW_TIER_MAX_MB="${RETRO_LOW_TIER_MAX_MB:-1800}"

export RETRO_LOW_ZRAM_PCT="75"
export RETRO_LOW_SWAPPINESS="100"
export RETRO_LOW_DIRTY_BG_RATIO="5"
export RETRO_LOW_DIRTY_RATIO="10"
export RETRO_LOW_EARLYOOM_ARGS="-m 4 -s 8"
export RETRO_LOW_PICOM="off"

export RETRO_STD_ZRAM_PCT="50"
export RETRO_STD_SWAPPINESS="60"
export RETRO_STD_DIRTY_BG_RATIO="8"
export RETRO_STD_DIRTY_RATIO="20"
export RETRO_STD_EARLYOOM_ARGS="-m 6 -s 10"
export RETRO_STD_PICOM="on"

export RETRO_ZRAM_ALGO="zstd"
export RETRO_VFS_CACHE_PRESSURE="50"

# -----------------------------------------------------------------------------
# Package toggles (set to 0 to shrink the image)
# -----------------------------------------------------------------------------
export RETRO_INSTALL_FIRMWARE="${RETRO_INSTALL_FIRMWARE:-1}"
export RETRO_INSTALL_BROWSER="${RETRO_INSTALL_BROWSER:-1}"
export RETRO_INSTALL_CALAMARES="${RETRO_INSTALL_CALAMARES:-1}"
export RETRO_SLIM_DPKG="${RETRO_SLIM_DPKG:-1}"   # drop /usr/share/doc + non-en locales
# Firmware deliberately excludes firmware-amd-graphics: it bloats the initramfs
# (module firmware is copied into it) which hurts 512 MB machines.
export RETRO_FIRMWARE_PKGS="firmware-linux-free firmware-misc-nonfree firmware-realtek firmware-atheros firmware-iwlwifi firmware-brcm80211"

# -----------------------------------------------------------------------------
# Modern Go/Rust auditing binaries (03_modules_setup.sh / retro-fetch-tools)
# -----------------------------------------------------------------------------
# channel=latest -> resolve newest GitHub release; falls back to the pinned
# versions below when the API is unreachable / rate-limited.
export RETRO_TOOLS_CHANNEL="${RETRO_TOOLS_CHANNEL:-latest}"
export RETRO_TOOLS_STRICT="${RETRO_TOOLS_STRICT:-0}"   # 1 = abort build if a tool cannot be staged
export RETRO_PIN_RUSTSCAN="2.3.0"
export RETRO_PIN_FFUF="2.1.0"
export RETRO_PIN_HTTPX="1.6.9"
export RETRO_PIN_NAABU="2.3.1"
export RETRO_GRUB_BTRFS_PIN="4.13"

# -----------------------------------------------------------------------------
# `retro update` source for local scripts (tarball URL, optional).
# Leave empty to only refresh apt/keys/menus. Expected layout of the tarball:
#   opt/retro-os/**, opt/retro-ai/**, usr/local/bin/retro
# An accompanying <url>.sha256 file is verified when present.
# -----------------------------------------------------------------------------
export RETRO_UPDATE_URL="${RETRO_UPDATE_URL:-}"

# -----------------------------------------------------------------------------
# Terminal colours (log output only)
# -----------------------------------------------------------------------------
export C_RESET=$'\033[0m'
export C_RED=$'\033[0;31m'
export C_GREEN=$'\033[0;32m'
export C_YELLOW=$'\033[0;33m'
export C_BLUE=$'\033[0;34m'
export C_CYAN=$'\033[0;36m'
export C_BOLD=$'\033[1m'

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
retro_log() {
    local level="$1"; shift
    local msg="$*" ts
    ts="$(date '+%Y-%m-%d %H:%M:%S')"
    mkdir -p "${RETRO_LOG_DIR}" 2>/dev/null || true
    printf '[%s] [%s] %s\n' "${ts}" "${level}" "${msg}" >> "${RETRO_LOG_FILE}" 2>/dev/null || true

    case "${level}" in
        INFO)  printf '%s[*]%s %s\n' "${C_CYAN}"   "${C_RESET}" "${msg}" ;;
        OK)    printf '%s[+]%s %s\n' "${C_GREEN}"  "${C_RESET}" "${msg}" ;;
        WARN)  printf '%s[!]%s %s\n' "${C_YELLOW}" "${C_RESET}" "${msg}" >&2 ;;
        ERROR) printf '%s[x]%s %s\n' "${C_RED}"    "${C_RESET}" "${msg}" >&2 ;;
        *)     printf '%s\n' "${msg}" ;;
    esac
}

retro_info()  { retro_log INFO  "$@"; }
retro_ok()    { retro_log OK    "$@"; }
retro_warn()  { retro_log WARN  "$@"; }
retro_error() { retro_log ERROR "$@"; }
retro_die()   { retro_error "$@"; exit 1; }

# ERR trap with file/line/command context. Usage (after sourcing):
#   retro_enable_traps "01_engine_setup.sh"
retro_err_trap() {
    local rc="$1" line="$2"
    retro_error "${RETRO_SCRIPT_NAME:-script} failed at line ${line}: '${BASH_COMMAND}' (exit ${rc})"
}
retro_enable_traps() {
    RETRO_SCRIPT_NAME="${1:-${0##*/}}"
    trap 'retro_err_trap "$?" "${LINENO}"' ERR
}

# -----------------------------------------------------------------------------
# Guards / helpers
# -----------------------------------------------------------------------------
require_root() {
    [[ "${EUID}" -eq 0 ]] || retro_die "This script must be run as root."
}

is_command() { command -v "$1" >/dev/null 2>&1; }

retro_require_chroot() {
    [[ "${RETRO_CONTEXT}" == "chroot" ]] || retro_die "This script must run inside the build chroot (RETRO_CONTEXT=chroot)."
    require_root
}

# retro_retry <tries> <delay_seconds> <command...>
retro_retry() {
    local tries="$1" delay="$2" n=1
    shift 2
    until "$@"; do
        if (( n >= tries )); then
            return 1
        fi
        retro_warn "attempt ${n}/${tries} failed: $*  (retrying in ${delay}s)"
        sleep "${delay}"
        n=$(( n + 1 ))
    done
}

# Write stdin to a file: retro_write <path> [mode]
retro_write() {
    local path="$1" mode="${2:-0644}"
    mkdir -p "$(dirname "${path}")"
    cat > "${path}"
    chmod "${mode}" "${path}"
}

# Chroot-only apt wrappers (never prompt, keep our config files on upgrade)
retro_apt() {
    DEBIAN_FRONTEND=noninteractive apt-get -y \
        -o Dpkg::Options::=--force-confdef \
        -o Dpkg::Options::=--force-confold \
        -o Acquire::Retries=5 "$@"
}

retro_apt_install() {
    retro_retry 3 5 retro_apt install --no-install-recommends "$@"
}

retro_pkg_candidate() {
    apt-cache policy "$1" 2>/dev/null | awk '/Candidate:/ {print $2}'
}

# Install packages one by one, tolerating those missing from the suite.
retro_apt_install_optional() {
    local pkg cand
    for pkg in "$@"; do
        cand="$(retro_pkg_candidate "${pkg}")"
        if [[ -n "${cand}" && "${cand}" != "(none)" ]]; then
            retro_apt_install "${pkg}" || retro_warn "optional package failed to install: ${pkg}"
        else
            retro_warn "optional package not available in ${DEBIAN_SUITE}: ${pkg}"
        fi
    done
}

if [[ "${RETRO_CONTEXT}" == "chroot" ]]; then
    mkdir -p "${RETRO_LOG_DIR}" "${RETRO_STATE_DIR}" "${RETRO_ETC_DIR}" 2>/dev/null || true
fi
