#!/usr/bin/env bash
# =============================================================================
# Retro OS v2.0 - config.env
# Centralized configuration sourced by every build/chroot script.
# Must be SOURCED, never executed directly.
# =============================================================================

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "config.env must be sourced, not executed directly." >&2
    exit 1
fi

if [[ -n "${RETRO_CONFIG_LOADED:-}" ]]; then
    return 0
fi
export RETRO_CONFIG_LOADED=1

set -Eeuo pipefail

# -----------------------------------------------------------------------------
# Distro identity
# -----------------------------------------------------------------------------
export RETRO_OS_NAME="Retro OS"
export RETRO_OS_CODENAME="retro-os"
export RETRO_OS_VERSION="2.0"
export RETRO_OS_EDITION="Tactical"

# -----------------------------------------------------------------------------
# Debian base
# -----------------------------------------------------------------------------
export DEBIAN_SUITE="bookworm"              # bookworm (stable) | trixie (testing)
export DEBIAN_MIRROR="https://deb.debian.org/debian/"
export DEBIAN_SECURITY_MIRROR="https://security.debian.org/debian-security"
export DEBIAN_COMPONENTS="main contrib non-free non-free-firmware"
export DEBIAN_ARCH="amd64"

# -----------------------------------------------------------------------------
# Build layout (host side, outside the chroot)
# -----------------------------------------------------------------------------
export BUILD_ROOT="${BUILD_ROOT:-$(pwd)/build}"
export CHROOT_DIR="${BUILD_ROOT}/chroot"
export IMAGE_DIR="${BUILD_ROOT}/image"
export ISO_DIR="${BUILD_ROOT}/iso"
export OUT_DIR="${BUILD_ROOT}/out"
export SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/scripts"
export OVERLAY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/overlay"

export ISO_LABEL="RETRO_OS_V2"
export ISO_FILENAME="retro-os-v2.0-${DEBIAN_ARCH}.iso"

# -----------------------------------------------------------------------------
# In-chroot filesystem paths (used by 01/02/03 scripts, which run INSIDE the
# chroot — these must be absolute paths as seen from inside it)
# -----------------------------------------------------------------------------
export RETRO_ROOT="/opt/retro-os"
export RETRO_AI_DIR="/opt/retro-ai"
export RETRO_BIN_DIR="/usr/local/bin"
export RETRO_ETC_DIR="/etc/retro-os"
export RETRO_LOG_DIR="/var/log/retro-os"
export RETRO_LOG_FILE="${RETRO_LOG_DIR}/retro-os.log"
export RETRO_STATE_DIR="/var/lib/retro-os"

# -----------------------------------------------------------------------------
# Default user
# -----------------------------------------------------------------------------
export RETRO_USER="retro"
export RETRO_USER_UID="1000"
export RETRO_USER_PASS="retro"
export RETRO_ROOT_PASS="retro"

# -----------------------------------------------------------------------------
# Theme / branding
# -----------------------------------------------------------------------------
export RETRO_ACCENT_COLOR="#00FF9C"   # Neon Mint
export RETRO_CRIMSON_COLOR="#FF0055"  # Cyber Crimson
export RETRO_BG_COLOR="#0C0D12"       # Obsidian
export RETRO_FG_COLOR="#E0E0E0"
export RETRO_FONT_NAME="JetBrainsMono Nerd Font"
export RETRO_ICON_THEME="Papirus-Dark"

# -----------------------------------------------------------------------------
# Terminal color codes (host/log output only)
# -----------------------------------------------------------------------------
export C_RESET='\033[0m'
export C_RED='\033[0;31m'
export C_GREEN='\033[0;32m'
export C_YELLOW='\033[0;33m'
export C_BLUE='\033[0;34m'
export C_CYAN='\033[0;36m'
export C_BOLD='\033[1m'

# -----------------------------------------------------------------------------
# Shared logging helpers
# -----------------------------------------------------------------------------
retro_log() {
    local level="$1"; shift
    local msg="$*"
    local ts
    ts="$(date '+%Y-%m-%d %H:%M:%S')"
    mkdir -p "${RETRO_LOG_DIR}" 2>/dev/null || true
    echo "[${ts}] [${level}] ${msg}" >> "${RETRO_LOG_FILE}" 2>/dev/null || true

    case "${level}" in
        INFO)  echo -e "${C_CYAN}[*]${C_RESET} ${msg}" ;;
        OK)    echo -e "${C_GREEN}[+]${C_RESET} ${msg}" ;;
        WARN)  echo -e "${C_YELLOW}[!]${C_RESET} ${msg}" ;;
        ERROR) echo -e "${C_RED}[x]${C_RESET} ${msg}" ;;
        *)     echo -e "${msg}" ;;
    esac
}

retro_info()  { retro_log INFO  "$@"; }
retro_ok()    { retro_log OK    "$@"; }
retro_warn()  { retro_log WARN  "$@"; }
retro_error() { retro_log ERROR "$@"; }
retro_die()   { retro_error "$@"; exit 1; }

# -----------------------------------------------------------------------------
# Common guards
# -----------------------------------------------------------------------------
require_root() {
    if [[ "${EUID}" -ne 0 ]]; then
        retro_die "This script must be run as root."
    fi
}

is_command() {
    command -v "$1" >/dev/null 2>&1
}

# Chroot setup scripts (01-03) run AS ROOT INSIDE THE CHROOT during the
# live-build, under `chroot "${CHROOT_DIR}" /bin/bash /tmp/0X_*.sh`.
# RULES inside the chroot:
#   - never call sudo (we already are root)
#   - never call `systemctl start` / `--now` (no running init) —
#     only `systemctl enable` (symlink creation) is allowed
#   - no network assumptions beyond what debootstrap/apt already set up

mkdir -p "${RETRO_LOG_DIR}" "${RETRO_STATE_DIR}" "${RETRO_ETC_DIR}" 2>/dev/null || true
